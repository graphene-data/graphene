@dialects { backtickIdentifier, doubleQuotedIdentifier, doubleQuotedString }

@top Program {
  (TableStatement ";"? | ViewStatement ";"? | ExtendStatement ";"? | queryWithSemi)* QueryStatement?
}

// Because QueryStatement is so flexible in what it accepts, we need semicolons between multiple queries within a single file.
queryWithSemi {
  QueryStatement ";"
}

QueryStatement {
  QueryExpression
}

QueryExpression {
  WithClause? (SimpleQuery | SetOperand SetOperator SetOperand (SetOperator SetOperand)*) OrderByClause? LimitClause?
}

SetOperand {
  SimpleQuery | SubqueryExpression
}

SimpleQuery {
  (FromClause | SelectClause | WhereClause | GroupByClause | HavingClause)+
}

SetOperator {
  Kw<"union"> (SoftKw<"all"> | Kw<"distinct">)? |
  Kw<"intersect"> |
  Kw<"except">
}

WithClause {
  Kw<"with"> CteDef ("," CteDef)*
}

CteDef {
  Alias Kw<"as"> "(" QueryExpression ")"
}

SelectClause {
  Kw<"select"> Kw<"distinct">? SelectItem ("," SelectItem)* ","?
}

SelectItem {
  expression (Kw<"as">? SelectAlias)? |
  Wildcard
}

SelectAlias {
  Identifier | QuotedIdentifier
}

Wildcard {
  (Identifier ".")* "*"
}

FromClause {
  Kw<"from"> tablePrimary (JoinClause)*
}

tablePrimary[@isGroup=TablePrimary] {
  TableName | Subquery
}

joinPrimary[@isGroup=TablePrimary] {
  TableName | Subquery | UnnestSource
}

TableName {
  Ref (Kw<"as">? Alias)?
}

Subquery {
  SubqueryExpression (Kw<"as">? Alias)?
}

JoinClause {
  (SoftKw<"inner"> | SoftKw<"left"> | SoftKw<"right"> | SoftKw<"full"> | SoftKw<"cross">)? Kw<"join"> joinPrimary (Kw<"on"> expression)?
}

UnnestSource {
  Kw<"unnest"> "(" expression ")" Kw<"as"> Alias
}

WhereClause {
  Kw<"where"> expression
}

GroupByClause {
  Kw<"group"> Kw<"by"> SelectItem ("," SelectItem)* ","?
}

HavingClause {
  Kw<"having"> expression
}

OrderByClause {
  Kw<"order"> Kw<"by"> OrderItem ("," OrderItem)* ","?
}

OrderItem {
  expression (Kw<"asc"> | Kw<"desc">)?
}

LimitClause {
  Kw<"limit"> Number (SoftKw<"offset"> Number)?
}

TableStatement {
  SoftKw<"table"> Ref "(" (tableItem ","?)+ ")"
}

ViewStatement {
  SoftKw<"table"> Ref Kw<"as"> "(" QueryExpression ")"
}

ExtendStatement {
  SoftKw<"extend"> Ref "(" (extendItem ","?)+ ")"
}

tableItem {
  (ColumnDef | JoinDef | ComputedDef)
}

extendItem {
  (JoinDef | ComputedDef)
}

ColumnDef {
  ColumnName DataType PrimaryKey?
}

ColumnName {
  Identifier
}

PrimaryKey {
  SoftKw<"primary_key">
}

JoinDef {
  JoinType Ref (Kw<"as"> Alias)? Kw<"on"> JoinCondition
}

JoinType {
  Kw<"join"> (SoftKw<"one"> | SoftKw<"many">)
}

ComputedDef {
  tableComputedExpression Kw<"as"> Alias |
  Alias ":" expression
}

DataType {
  TypeName
}

TypeName {
  ScalarType | ArrayType
}

ScalarType {
  Identifier
}

ArrayType {
  SoftKw<"array"> "<" TypeName ">"
}

// Ideally we could just use `expression` as the join condition, but that introduces ambiguity when parsing, since we don't know when the expression ends and new ComputedDef begins.
// We could require commas, or make every ComputeDef start with `computed`, but those both feel a bit clumsy.
JoinCondition[@isGroup=Expression, @name=BinaryExpression] {
  Ref "=" Ref
}

// We use a parameterized precedence ladder to avoid duplication between 'expression' (which can start with anything)
// and 'computedExpression' (which cannot start with a parenthesis, to avoid ambiguity with the 'name: expr' syntax).
expression[@isGroup=Expression] {
  orTier<baseExpression | parenExpression>
}

// In table blocks, `interval <ref> <unit> as <alias>` collides with `interval <type>` column defs.
// Keep `expr as alias` syntax, but use a table-specific expression that only allows
// interval string/numeric quantities here. Field-based interval quantities still work in
// normal expressions and in `alias: expression` table defs.
tableComputedExpression[@isGroup=Expression] {
  orTier<tableBaseExpression>
}

// Expression precedence ladder: each tier either parses its own operator or falls through to the next tighter tier.
// This lets us handle precedence at the parsing layer.
orTier<T> { OrExpression<T> | andTier<T> }
andTier<T> { AndExpression<T> | compareTier<T> }
compareTier<T> { BetweenExpression<T> | InExpression<T> | NullTestExpression<T> | ComparisonExpression<T> | addTier<T> }
addTier<T> { AddExpression<T> | multiplyTier<T> }
multiplyTier<T> { MultiplyExpression<T> | unaryTier<T> }
unaryTier<T> { UnaryExpression<T> | castTier<T> }
castTier<T> { TypeCastExpression<T> | T }

// Casting: supports both CAST(x AS type) and x::type syntaxes
CastExpression {
  SoftKw<"cast"> "(" expression Kw<"as"> CastType ")"
}

TypeCastExpression[@isGroup=Expression]<T> {
  castTier<T> !cast "::" CastType
}

CastType {
  TypeName
}

// baseExpression includes all expression starts that are NOT parentheses.
baseExpression {
  CaseExpression |
  ExistsExpression |
  computedPrimary |
  ExtractExpression |
  CastExpression |
  IntervalExpression |
  DateExpression |
  TimestampExpression |
  Param
}

tableBaseExpression {
  CaseExpression |
  ExistsExpression |
  computedPrimary |
  ExtractExpression |
  CastExpression |
  IntervalExpressionNoRef |
  DateExpression |
  TimestampExpression |
  Param
}

// Interval: supports `interval '1 day'`, `interval 1 day`, or `interval field_name day`
IntervalExpression {
  SoftKw<"interval"> (String | intervalQuantity IntervalUnit)
}

IntervalExpressionNoRef {
  SoftKw<"interval"> (String | Number IntervalUnit)
}

intervalQuantity[@isGroup=Expression] {
  Number |
  Ref
}

IntervalUnit {
  Identifier
}

// Date: supports `date '2025-01-01'`
DateExpression {
  SoftKw<"date"> String
}

// Timestamp: supports `timestamp '2025-01-01 12:00:00'`
TimestampExpression {
  SoftKw<"timestamp"> String
}

// parenExpression includes all expression starts that ARE parentheses.
parenExpression {
  Parenthetical |
  SubqueryExpression
}

UnaryExpression[@isGroup=Expression]<T> {
  UnaryOperator !unary unaryTier<T>
}

ComparisonOp {
  "=" | "!=" | "<>" | "<" | ">" | "<=" | ">=" |
  Kw<"like"> | Kw<"ilike"> | Kw<"not"> (Kw<"like"> | Kw<"ilike">)
}

AddOp { "+" | "-" | "||" }
MulOp { "*" | "/" | "%" }

UnaryOperator {
  Kw<"not"> | "-" | "+"
}

CaseExpression {
  Kw<"case"> (expression)? (WhenClause)+ (ElseClause)? Kw<"end">
}

WhenClause {
  Kw<"when"> expression Kw<"then"> expression
}

ElseClause {
  Kw<"else"> expression
}

ExistsExpression {
  Kw<"exists"> "(" QueryExpression ")"
}

InValueList {
  expression ("," expression)* ","?
}

@precedence {
  cast @left,
  unary @left,
  multiply @left,
  add @left,
  compare @left,
  and @left,
  or @left,
  binary @cut
}

OrExpression[@isGroup=Expression]<T> {
  orTier<T> !or Kw<"or"> andTier<T>
}

AndExpression[@isGroup=Expression]<T> {
  andTier<T> !and Kw<"and"> compareTier<T>
}

ComparisonExpression[@isGroup=Expression]<T> {
  addTier<T> !compare ComparisonOp addTier<T>
}

AddExpression[@isGroup=Expression]<T> {
  addTier<T> !add AddOp multiplyTier<T>
}

MultiplyExpression[@isGroup=Expression]<T> {
  multiplyTier<T> !multiply MulOp unaryTier<T>
}

InExpression[@isGroup=Expression]<T> {
  addTier<T> !compare Kw<"in"> "(" (InValueList | QueryExpression) ")" |
  addTier<T> !compare Kw<"not"> Kw<"in"> "(" (InValueList | QueryExpression) ")"
}

BetweenExpression[@isGroup=Expression]<T> {
  addTier<T> !compare Kw<"between"> addTier<T> Kw<"and"> addTier<T> |
  addTier<T> !compare Kw<"not"> Kw<"between"> addTier<T> Kw<"and"> addTier<T>
}

NullTestExpression[@isGroup=Expression]<T> {
  addTier<T> !compare Kw<"is"> Kw<"not">? Kw<"null">
}

computedPrimary {
  literal |
  WindowExpression |
  FunctionCall |
  Ref |
  Count
}

WindowExpression[@isGroup=Expression] {
  (FunctionCall | Count) OverClause
}

OverClause {
  SoftKw<"over"> "(" ")" |
  SoftKw<"over"> "(" WindowSpec ")"
}

WindowSpec {
  WindowPartitionClause WindowOrderByClause? WindowFrameClause? |
  WindowOrderByClause WindowFrameClause? |
  WindowFrameClause
}

WindowPartitionClause {
  SoftKw<"partition"> Kw<"by"> expression ("," expression)* ","?
}

WindowOrderByClause {
  Kw<"order"> Kw<"by"> WindowOrderItem ("," WindowOrderItem)* ","?
}

WindowOrderItem {
  expression (Kw<"asc"> | Kw<"desc">)?
}

WindowFrameClause {
  (SoftKw<"rows"> | SoftKw<"range">) (WindowFrameBetween | WindowFrameStart)
}

WindowFrameStart {
  WindowFrameBound
}

WindowFrameBetween {
  Kw<"between"> WindowFrameBound Kw<"and"> WindowFrameBound
}

WindowFrameBound {
  SoftKw<"unbounded"> (SoftKw<"preceding"> | SoftKw<"following">) |
  SoftKw<"current"> SoftKw<"row"> |
  expression (SoftKw<"preceding"> | SoftKw<"following">)
}

Parenthetical {
  "(" expression ")"
}

SubqueryExpression {
  "(" QueryExpression ")"
}

Ref {
  (Identifier ".")* (Identifier | QuotedIdentifier)
}

QuotedIdentifier {
  backtickIdentifierToken | doubleQuotedIdentifierToken
}

String {
  singleQuotedStringToken | doubleQuotedStringToken
}

Count {
  SoftKw<"count"> "(" ("*"? | Kw<"distinct">? expression) ")"
}

ExtractExpression {
  SoftKw<"extract"> "(" ExtractUnit Kw<"from"> expression ")"
}

ExtractUnit {
  Identifier | String
}

FunctionCall {
  FunctionName "(" (expression ("," expression)* ","?)? ")"
}

FunctionName {
  Identifier
}

literal {
  Number |
  String |
  Boolean |
  Null
}

Boolean { Kw<"true"> | Kw<"false"> }
Null { Kw<"null"> }

// Kw is a hard (reserved) keyword: clause/operator words like select, from, and.
Kw<term> { @specialize[@name={term}]<Identifier, term> }
// SoftKw is a keyword that may also be used as an identifier (e.g. `as date`, a column named `rows`, `range(3)`).
// The parser tries both readings; @dynamicPrecedence prefers the keyword when both parse (count(), full join, current row).
// @name=Kw keeps the node name identical so the analyzer doesn't distinguish the two.
SoftKw[@name=Kw, @dynamicPrecedence=1]<term> { @extend[@name={term}]<Identifier, term> }
Alias { Identifier }

@skip { whitespace | comment }

@tokens {
  whitespace { @whitespace+ }
  comment { "--" ![\n]* | "#" ![\n]* | "/*" ![*]* "*"+ (![/*] ![*]* "*"+)* "/" }

  Identifier { (@asciiLetter | "_") (@asciiLetter | @digit | "_")* }
  backtickIdentifierToken[@dialect=backtickIdentifier] { "`" ![`]* "`" }
  doubleQuotedIdentifierToken[@dialect=doubleQuotedIdentifier] { '"' !["]* '"' }
  singleQuotedStringToken { "'" ![']* "'" }
  doubleQuotedStringToken[@dialect=doubleQuotedString] { '"' !["]* '"' }
  Param { "$" (@asciiLetter | @digit | "_")+ }
  Number { @digit+ ("." @digit+)? }
  "*" "+" "-" "/" "%" "=" "!=" "<>" "<" ">" "<=" ">=" "::" "||"

  @precedence { doubleQuotedIdentifierToken, doubleQuotedStringToken }
  @precedence { comment, "-" }
  @precedence { comment, "*" }
  @precedence { comment, "/" }
  @precedence { "::", ":" }
  ":"
}

@external specialize {Identifier} specializeIdentifier from "./tokens.js" {
}

@external extend {Identifier} extendIdentifier from "./tokens.js" {
}
