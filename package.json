{
  "name": "graphene",
  "version": "0.0.28",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint -c oxlint.config.ts . && eslint . && svelte-check --tsgo --workspace ui --tsconfig tsconfig.json",
    "lint:fix": "oxlint -c oxlint.config.ts . --fix && eslint . --fix",
    "test": "vitest run",
    "test-one": "node scripts/turboTest.js",
    "check-examples": "pnpm -C examples/flights graphene check && pnpm -C examples/ecomm graphene check && pnpm -C examples/snowflake graphene check && pnpm -C examples/clickhouse graphene check"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^3.12.10",
    "@types/node": "^22.19.7",
    "@typescript/native": "npm:typescript@~7.0.2",
    "dotenv": "^17.2.3",
    "eslint": "^10.9.1",
    "eslint-plugin-prefer-let": "^4.0.1",
    "eslint-plugin-svelte": "^3.23.0",
    "glob": "^13.0.6",
    "globals": "^16.5.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "4.1.10",
    "vscode-uri": "^3.1.0",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
